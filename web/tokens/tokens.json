{
  "$description": "Design tokens for silly-demos in the W3C Design Tokens (DTCG) format. scripts/build-tokens.js turns them into CSS custom properties and a typed TS module for canvas drawing. Primitives hold raw values; everything under `semantic` references them and is what components use. Color modes live in `semantic.light` and `semantic.dark`.",
  "primitive": {
    "color": {
      "$type": "color",
      "ink": {
        "900": { "$value": "#18222d" },
        "100": { "$value": "#d8e0e7" }
      },
      "paper": {
        "100": { "$value": "#e8edef" },
        "50": { "$value": "#f3f6f7" },
        "900": { "$value": "#10161d" },
        "850": { "$value": "#161e27" }
      },
      "cobalt": {
        "600": { "$value": "#2547c9" },
        "300": { "$value": "#7d98ff" }
      },
      "signal": {
        "600": { "$value": "#cc1f63" },
        "300": { "$value": "#ff5c93" }
      },
      "verdigris": {
        "600": { "$value": "#0f7f67" },
        "300": { "$value": "#3cc7a4" }
      },
      "amber": {
        "600": { "$value": "#b8860b" },
        "300": { "$value": "#f2c14e" }
      }
    }
  },
  "semantic": {
    "light": {
      "color": {
        "$type": "color",
        "paper": { "$value": "{primitive.color.paper.100}", "$description": "Drawing sheet and page background" },
        "paper-raised": { "$value": "{primitive.color.paper.50}", "$description": "Title block, masthead" },
        "ink": { "$value": "{primitive.color.ink.900}", "$description": "Primary text and outlines" },
        "ink-soft": { "$value": "rgb(24 34 45 / 0.62)", "$description": "Secondary text, dimension lines" },
        "ink-faint": { "$value": "rgb(24 34 45 / 0.22)", "$description": "Hairlines, inactive marks" },
        "rule": { "$value": "rgb(24 34 45 / 0.9)", "$description": "Panel borders" },
        "grid-minor": { "$value": "rgb(37 71 201 / 0.035)" },
        "grid-major": { "$value": "rgb(37 71 201 / 0.09)" },
        "cobalt": { "$value": "{primitive.color.cobalt.600}", "$description": "Construction, separated, information" },
        "cobalt-faint": { "$value": "rgb(37 71 201 / 0.1)" },
        "signal": { "$value": "{primitive.color.signal.600}", "$description": "Contact, overlap, attention" },
        "signal-faint": { "$value": "rgb(204 31 99 / 0.12)" },
        "verdigris": { "$value": "{primitive.color.verdigris.600}", "$description": "Tested features, secondary construction" },
        "amber": { "$value": "{primitive.color.amber.600}", "$description": "Candidate regions" }
      }
    },
    "dark": {
      "color": {
        "$type": "color",
        "paper": { "$value": "{primitive.color.paper.900}" },
        "paper-raised": { "$value": "{primitive.color.paper.850}" },
        "ink": { "$value": "{primitive.color.ink.100}" },
        "ink-soft": { "$value": "rgb(216 224 231 / 0.62)" },
        "ink-faint": { "$value": "rgb(216 224 231 / 0.2)" },
        "rule": { "$value": "rgb(216 224 231 / 0.55)" },
        "grid-minor": { "$value": "rgb(125 152 255 / 0.03)" },
        "grid-major": { "$value": "rgb(125 152 255 / 0.08)" },
        "cobalt": { "$value": "{primitive.color.cobalt.300}" },
        "cobalt-faint": { "$value": "rgb(125 152 255 / 0.12)" },
        "signal": { "$value": "{primitive.color.signal.300}" },
        "signal-faint": { "$value": "rgb(255 92 147 / 0.14)" },
        "verdigris": { "$value": "{primitive.color.verdigris.300}" },
        "amber": { "$value": "{primitive.color.amber.300}" }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Archivo", "Helvetica Neue", "Arial", "sans-serif"] },
      "code": { "$value": ["Fira Code", "ui-monospace", "SF Mono", "Consolas", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": { "value": 12, "unit": "px" }, "$description": "Readout labels, table text" },
      "sm": { "$value": { "value": 13, "unit": "px" }, "$description": "Control labels, notes" },
      "md": { "$value": { "value": 14, "unit": "px" }, "$description": "Controls, summaries" },
      "base": { "$value": { "value": 15, "unit": "px" }, "$description": "Body text" },
      "lg": { "$value": { "value": 18, "unit": "px" }, "$description": "Lede" },
      "xl": { "$value": { "value": 22, "unit": "px" }, "$description": "Readout values" },
      "2xl": { "$value": { "value": 28, "unit": "px" }, "$description": "Index entries" },
      "3xl": { "$value": { "value": 30, "unit": "px" }, "$description": "Sheet titles" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "heavy": { "$value": 800 }
    },
    "stretch": {
      "$type": "number",
      "$description": "Archivo width axis, as a percentage",
      "$extensions": { "dev.silly-demos.css-unit": "%" },
      "normal": { "$value": 100 },
      "wide": { "$value": 112 },
      "wider": { "$value": 125 }
    },
    "canvas-label": {
      "$type": "dimension",
      "$description": "Text drawn on the canvas",
      "$value": { "value": 12, "unit": "px" }
    }
  },
  "space": {
    "$type": "dimension",
    "3xs": { "$value": { "value": 2, "unit": "px" } },
    "2xs": { "$value": { "value": 4, "unit": "px" } },
    "xs": { "$value": { "value": 6, "unit": "px" } },
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 10, "unit": "px" } },
    "lg": { "$value": { "value": 14, "unit": "px" } },
    "xl": { "$value": { "value": 18, "unit": "px" } },
    "2xl": { "$value": { "value": 20, "unit": "px" } },
    "3xl": { "$value": { "value": 24, "unit": "px" } },
    "4xl": { "$value": { "value": 32, "unit": "px" } }
  },
  "size": {
    "$type": "dimension",
    "masthead": { "$value": { "value": 56, "unit": "px" } },
    "title-block": { "$value": { "value": 340, "unit": "px" }, "$description": "Width of the side panel" },
    "grid-minor": { "$value": { "value": 8, "unit": "px" } },
    "grid-major": { "$value": { "value": 40, "unit": "px" } },
    "handle": { "$value": { "value": 6, "unit": "px" }, "$description": "Radius of draggable canvas handles" },
    "handle-hit": { "$value": { "value": 10, "unit": "px" }, "$description": "Pointer distance that grabs a handle" }
  },
  "border": {
    "$type": "dimension",
    "hairline": { "$value": { "value": 1, "unit": "px" } },
    "accent": { "$value": { "value": 2, "unit": "px" } },
    "tab": { "$value": { "value": 3, "unit": "px" } },
    "radius": { "$value": { "value": 2, "unit": "px" } }
  }
}
